# MaxmaHere 环境变量
#
# 只有这里列出的键有代码读取。Provider 的 API Key / base_url / model 一律经
# Web UI 的 /providers 管理（存 providers.yaml，凭据信封加密），不放这里。
#
# 取值优先级：进程环境变量 > 数据目录 .env > 默认值（大小写不敏感）。
# install.bat 会把本文件复制为 .env。

# ── 端口 ──
# 后端实际监听端口由 MAXMA_BUN_PORT 决定（默认 8000）。
# 下面两个键只影响 CORS origin 白名单（cors-config.ts），不改监听端口。
MAXMA_API_PORT=8000
MAXMA_WEB_PORT=5173

# ── 可选开关 ──
# 思考路径面板（默认 false）
THINK_PATH_ENABLED=false
# Provider 诊断采集（默认 false）
PROVIDER_DIAGNOSTICS_ENABLED=false

# ── 以下键由启动器/打包脚本注入，通常不需要手填 ──
# MAXMA_DATA_DIR      可写数据目录（最高优先，覆盖便携/标准判定）
# MAXMA_BUNDLE_DIR    只读资源根（打包形态）
# MAXMA_EXE_DIR       可执行文件所在目录（配合 portable.flag 判定便携模式）
# MAXMA_BUN_HOST      后端绑定地址（默认 127.0.0.1）
# MAXMA_BUN_PORT      后端端口（桌面包注入随机空闲端口）
# MAXMA_ENV           production 时追加 localhost/127.0.0.1 到 CORS origin
# PI_CODING_AGENT_DIR pi 引擎自己的配置目录（注入失效会让会话与凭据写进用户主目录）
# DSH_HOME / DSH_JET_HUB_STATE_DIR  插件账号池落点（由插件宿主注入）
